# =========================
# LLM Integration
# =========================
# Get this from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# =========================
# Knowledge Graph (Neo4j)
# =========================
# If running via docker-compose from the backend container, the host is 'neo4j'
# If running locally without docker, it's 'localhost'
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Change this in production, but 'password' is fine for the hackathon local sprint
NEO4J_PASSWORD=password

# =========================
# Vector Database (ChromaDB)
# =========================
# If running via docker-compose from the backend container, the host is 'chromadb'
# If running locally without docker, it's 'localhost'
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# =========================
# Frontend Environment
# =========================
# Tells Vite where to hit the FastAPI backend
VITE_API_URL=http://localhost:8000